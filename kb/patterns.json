def load_dynamic_rules(self):
    rules = []

    for p in self.kb.patterns:
        if not p.get("enabled"):
            continue

        rules.append({
            "id": p["id"],
            "name": f"[AUTO] Pattern detected: {p['pattern']}",
            "severity": p.get("severity", "low"),
            "patterns": [p["pattern"]],
            "confidence": p.get("confidence", 0.5),
            "source": "knowledge_base"
        })

    return rules
